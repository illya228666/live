    },
    "packages": [
      {
        "id": "movement",
        "version": "1.0.0"
      },
      {
        "id": "vision",
        "version": "1.0.0"
      },
      {
        "id": "temperature",
        "version": "1.0.0"
      },
      {
        "id": "homeostasis",
        "version": "1.0.0"
      },
      {
