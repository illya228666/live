config_version=5

[application]
config/name="ArtificialLife"
run/main_scene="res://Main.tscn"
config/features=PackedStringArray("4.7", "C#", "GL Compatibility")

[dotnet]
project/assembly_name="ArtificialLife.Godot"

[display]
window/size/viewport_width=1220
window/size/viewport_height=820
window/stretch/mode="canvas_items"

[rendering]
renderer/rendering_method="gl_compatibility"
environment/defaults/default_clear_color=Color(0.035, 0.05, 0.08, 1)
