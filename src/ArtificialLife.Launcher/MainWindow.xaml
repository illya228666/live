<Window x:Class="ArtificialLife.Launcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="ArtificialLife — лаунчер"
        Width="780" Height="620" MinWidth="700" MinHeight="560"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource WindowBackground}"
        Foreground="#E5EDF5"
        FontFamily="Segoe UI"
        FontSize="14">
    <Grid Margin="34,26">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="22" />
            <RowDefinition Height="*" />
            <RowDefinition Height="20" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="ArtificialLife" FontSize="28" FontWeight="SemiBold" />
            <TextBlock Text="Запуск симуляции и настройка обучения"
                       Margin="0,4,0,0" Foreground="{StaticResource MutedForeground}" />
        </StackPanel>

        <Border Grid.Row="2" Padding="24" Background="{StaticResource PanelBackground}"
                BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="155" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="96" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="18" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="14" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="20" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" Grid.Column="0" Grid.ColumnSpan="3" Text="Параметры запуска"
                           FontSize="17" FontWeight="SemiBold" />

                <TextBlock Grid.Row="2" Grid.Column="0" Text="Режим запуска" />
                <ComboBox x:Name="ModeBox" Grid.Row="2" Grid.Column="1" Grid.ColumnSpan="2"
                          SelectedIndex="0" SelectionChanged="ModeBox_SelectionChanged">
                    <ComboBoxItem Content="Просмотр готовой модели" />
                    <ComboBoxItem Content="Живое обучение в окне" />
                    <ComboBoxItem Content="Обучение в терминале" />
                </ComboBox>

                <TextBlock x:Name="ConfigLabel" Grid.Row="4" Grid.Column="0" Text="Конфигурация" />
                <TextBox x:Name="ConfigBox" Grid.Row="4" Grid.Column="1" Text="configs/default.json" />
                <Button x:Name="ChooseConfigButton" Grid.Row="4" Grid.Column="2" Margin="10,0,0,0"
                        Content="Обзор…" Click="ChooseConfig_Click" />

                <TextBlock x:Name="SpeedLabel" Grid.Row="6" Grid.Column="0" Text="Скорость" />
                <ComboBox x:Name="SpeedBox" Grid.Row="6" Grid.Column="1" Grid.ColumnSpan="2" Width="260"
                          HorizontalAlignment="Left" SelectedIndex="1">
                    <ComboBoxItem Content="Обычная — 1×" />
                    <ComboBoxItem Content="Быстрая — 10×" />
                    <ComboBoxItem Content="Очень быстрая — 100×" />
                    <ComboBoxItem Content="Максимальная" />
                </ComboBox>

                <TextBlock Grid.Row="8" Grid.Column="0" Text="Чекпойнт" />
                <TextBox x:Name="CheckpointBox" Grid.Row="8" Grid.Column="1" Text="artifacts/checkpoints/thermal" />
                <Button Grid.Row="8" Grid.Column="2" Margin="10,0,0,0" Content="Обзор…"
                        Click="ChooseCheckpoint_Click" />

                <TextBlock x:Name="StepsLabel" Grid.Row="10" Grid.Column="0" Text="Шаги обучения" />
                <TextBox x:Name="StepsBox" Grid.Row="10" Grid.Column="1" Width="180"
                         HorizontalAlignment="Left" Text="100000" />

                <Border Grid.Row="12" Grid.Column="0" Grid.ColumnSpan="3" Padding="14"
                        Background="#0D1724" BorderBrush="#27364A" BorderThickness="1" CornerRadius="8"
                        VerticalAlignment="Top">
                    <TextBlock x:Name="DescriptionText" TextWrapping="Wrap" LineHeight="22"
                               Foreground="{StaticResource MutedForeground}" />
                </Border>
            </Grid>
        </Border>

        <Grid Grid.Row="4">
            <TextBlock Text="Для первого запуска обучите модель или укажите существующий чекпойнт."
                       Foreground="{StaticResource MutedForeground}" VerticalAlignment="Center" />
            <Button Content="Запустить" Width="150" Height="42" HorizontalAlignment="Right"
                    Background="{StaticResource AccentBrush}" Foreground="#07130F" FontWeight="SemiBold"
                    BorderThickness="0" IsDefault="True" Click="Launch_Click" />
        </Grid>
    </Grid>
</Window>
