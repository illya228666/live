<Application x:Class="ArtificialLife.Launcher.App"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             StartupUri="MainWindow.xaml">
    <Application.Resources>
        <SolidColorBrush x:Key="WindowBackground" Color="#0B1220" />
        <SolidColorBrush x:Key="PanelBackground" Color="#121D2C" />
        <SolidColorBrush x:Key="BorderBrush" Color="#27364A" />
        <SolidColorBrush x:Key="MutedForeground" Color="#91A4BA" />
        <SolidColorBrush x:Key="AccentBrush" Color="#58D6B5" />
        <Style TargetType="TextBlock">
            <Setter Property="Foreground" Value="#E5EDF5" />
            <Setter Property="VerticalAlignment" Value="Center" />
        </Style>
        <Style TargetType="TextBox">
            <Setter Property="Padding" Value="10,7" />
            <Setter Property="Background" Value="#0B1421" />
            <Setter Property="Foreground" Value="#E5EDF5" />
            <Setter Property="BorderBrush" Value="#34465C" />
            <Setter Property="CaretBrush" Value="#58D6B5" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="ComboBox">
            <Setter Property="Padding" Value="8,6" />
            <Setter Property="Background" Value="#0B1421" />
            <Setter Property="Foreground" Value="#E5EDF5" />
            <Setter Property="BorderBrush" Value="#34465C" />
            <Setter Property="VerticalContentAlignment" Value="Center" />
        </Style>
        <Style TargetType="Button">
            <Setter Property="Padding" Value="12,8" />
            <Setter Property="Background" Value="#1A2B3D" />
            <Setter Property="Foreground" Value="#E5EDF5" />
            <Setter Property="BorderBrush" Value="#3A5269" />
            <Setter Property="Cursor" Value="Hand" />
        </Style>
    </Application.Resources>
</Application>
